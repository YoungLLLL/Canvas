# ARTIC asks production integrations to identify the project and provide a contact address.
ARTIC_USER_AGENT="Canvium Gallery (contact@example.com)"

# Optional local metadata cache. Relative paths are resolved from apps/web.
# This stores Wikimedia mappings and rights metadata, never image binaries.
WIKIMEDIA_CACHE_DIR=".cache/wikimedia/artic"

# Server-only Qwen configuration. Never prefix the API key with NEXT_PUBLIC_.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VL_MODEL=qwen3-vl-plus
